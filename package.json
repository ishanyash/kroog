{
  "name": "kroog",
  "version": "1.5.0",
  "description": "Kroog: the map of your Claude Code chats. See what each chat did and how they connect, start the next chat with the context of earlier ones, and watch your plan's usage. Runs only on your computer.",
  "type": "module",
  "private": true,
  "bin": {
    "kroog": "bin/kroog.js"
  },
  "scripts": {
    "start": "node bin/kroog.js start",
    "demo": "node bin/kroog.js demo",
    "link": "node bin/kroog.js link",
    "unlink": "node bin/kroog.js unlink",
    "status": "node bin/kroog.js status",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ishanyash/kroog.git"
  },
  "homepage": "https://ishanyash.github.io/kroog/",
  "bugs": {
    "url": "https://github.com/ishanyash/kroog/issues"
  },
  "author": "Ishan Yash",
  "keywords": [
    "claude-code",
    "claude",
    "claude-code-plugin",
    "developer-tools",
    "local-first",
    "ai-coding",
    "chats",
    "map"
  ],
  "files": [
    "bin",
    "src",
    "public",
    "mod",
    ".claude-plugin",
    "README.md",
    "LICENSE",
    "NOTICE",
    "SECURITY.md"
  ]
}
